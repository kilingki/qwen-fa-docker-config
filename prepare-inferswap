#!/usr/bin/env bash
# Make the FA control endpoint reachable.
# A new or stopped container starts unloaded and does not load the model.
# A running container is left as it is, including ready or in-flight work.
set -euo pipefail

cd "$(dirname "$0")"

port="${FA_API_PORT:-}"
if [[ -z "$port" && -f .env ]]; then
  port="$(grep -E '^[[:space:]]*FA_API_PORT=' .env | tail -n 1 | cut -d= -f2- | tr -d '[:space:]"'"'" || true)"
fi
port="${port:-8090}"

status_url="http://127.0.0.1:${port}/control/status"

fetch_status() {
  python3 - "${status_url}" <<'PY'
import json
import sys
import urllib.request

url = sys.argv[1]
with urllib.request.urlopen(url, timeout=3) as response:
    payload = json.loads(response.read().decode("utf-8"))
print(json.dumps(payload))
PY
}

running="$(docker compose ps -q fa-api || true)"
if [[ -n "${running}" ]]; then
  if fetch_status >/dev/null; then
    exit 0
  fi
  echo "fa-api container is running but GET /control/status failed; not restarting" >&2
  exit 1
fi

docker compose up -d --no-build --no-recreate

for _ in $(seq 1 60); do
  if payload="$(fetch_status 2>/dev/null)"; then
    python3 - "${payload}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
ok = (
    payload.get("state") == "unloaded"
    and payload.get("residency") == "not_resident"
    and payload.get("active_requests") == 0
)
raise SystemExit(0 if ok else 1)
PY
    exit 0
  fi
  sleep 1
done

echo "new runtime did not report unloaded/not_resident" >&2
exit 1
